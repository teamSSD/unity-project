  m_Script: {fileID: 11500000, guid: 929a58dbdcff141c4a39130b9a1497bb, type: 3}
  m_Name: FirstMeet
  m_EditorClassIdentifier: Game.Runtime::DialogueSO
  entries:
  - speaker: "\uC790\uB974"
    text: "\uC774 \uAD6C\uC5ED \uCC98\uC74C\uC774\uC9C0? \uB0C4\uC0C8\uB9CC \uB9E1\uC544\uB3C4
      \uC54C\uACA0\uB2E4."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uBC30\uB2EC \uB54C\uBB38\uC5D0 \uC790\uC8FC \uC624\uC9C4 \uC54A\uC544\uC694.
      \uC0B4\uC544 \uB3CC\uC544\uAC00\uAE30 \uD798\uB4E4\uAC70\uB4E0\uC694."
    choices: []
  - speaker: "\uAC8C\uD1A0\uB85C"
    text: "\uC548\uC804 \uD655\uB960 43%. \uD3C9\uADE0 \uC774\uD558\uC785\uB2C8\uB2E4."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uC704\uB85C\uAC00 \uB418\uB294 \uC218\uCE58\uB294 \uC544\uB2C8\uB124\uC694."
    choices: []
  - speaker: "\uC790\uB974"
    text: "\uC5EC\uAE30\uC120 \uBC30\uBCF4\uB2E4 \uC804\uAE30\uAC00 \uBA3C\uC800
      \uACE0\uC7A5 \uB098\uC9C0."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uADF8\uB798\uC11C \uBC30\uB2EC\uC774 \uD544\uC694\uD55C \uAC70\uACA0\uC8E0."
    choices: []
