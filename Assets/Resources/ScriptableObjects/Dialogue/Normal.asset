  entries:
  - speaker: "\uC790\uB974"
    text: "\uAC81\uBA39\uC740 \uD45C\uC815\uC778\uB370, \uAD1C\uCC2E\uACA0\uC5B4?"
    choices:
    - label: "\uAD1C\uCC2E\uC544\uC694\\n\uC774\uB7F0 \uACF3\uB3C4 \uC77C\uC774\uB2C8\uAE4C\uC694."
      responses:
      - speaker: "\uC790\uB974"
        text: "\uD558, \uB9C8\uC74C\uC5D0 \uB4DC\uB294\uAD70. \uBC30\uB2EC\uAFBC\uB2F5\uB124."
      resultTag: 
    - label: "\uC194\uC9C1\uD788 \uC704\uD5D8\uD574 \uBCF4\uC5EC\uC694\\n\uAC10\uC804\uC740
        \uBCC4\uB85C \uC548 \uC88B\uC544\uD574\uC11C\uC694."
      responses:
      - speaker: "\uC790\uB974"
        text: "\uC194\uC9C1\uD55C \uB188\uC774 \uC624\uB798 \uC0B4\uC9C0. \uC870\uC2EC\uB9CC
          \uD574\uB77C."
      resultTag: 
