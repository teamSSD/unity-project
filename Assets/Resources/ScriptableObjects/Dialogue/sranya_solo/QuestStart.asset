  m_Script: {fileID: 11500000, guid: 929a58dbdcff141c4a39130b9a1497bb, type: 3}
  m_Name: QuestStart
  m_EditorClassIdentifier: Game.Runtime::DialogueSO
  entries:
  - speaker: "\uC2A4\uB77C\uB0D0"
    text: "\uBD80\uD0C1\uC774 \uD558\uB098 \uC788\uC5B4. \uC0C8\uBCBD\uAD6D \uB9CC\uB4E4
      \uC218 \uC788\uC5B4?"
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uC0C8\uBCBD\uAD6D\uC774\uC694? \uC7AC\uB8CC\uAC00 \uC880 \uD2B9\uC774\uD558\uB358\uB370\u2026"
    choices:
    - label: "\uD574\uBCFC\uAC8C\uC694.\\n\uC0C8\uBCBD\uD480\uB9CC \uAD6C\uD558\uBA74
        \uB420 \uAC83 \uAC19\uC544\uC694."
      responses:
      - speaker: "\uD50C\uB808\uC774\uC5B4"
        text: "\uAD6C\uD574\uBCFC\uAC8C\uC694. \uC0C8\uBCBD\uD480\uC774 \uD575\uC2EC\uC774\uC8E0?"
      - speaker: "\uC2A4\uB77C\uB0D0"
        text: "\uB9DE\uC544. \uAE30\uB2E4\uB9B4\uAC8C."
      resultTag: accept
    - label: "\uC880 \uC0DD\uAC01\uD574\uBCFC\uAC8C\uC694.\\n\uC544\uC9C1 \uC900\uBE44\uAC00
        \uC548 \uB410\uC5B4\uC694."
      responses:
      - speaker: "\uC2A4\uB77C\uB0D0"
        text: "\uADF8\uB798, \uC900\uBE44\uB418\uBA74 \uB2E4\uC2DC \uC640."
      resultTag: defer
