  entries:
  - speaker: "\uC2A4\uB77C\uB0D0"
    text: "\uCC98\uC74C \uBCF4\uB294 \uC5BC\uAD74\uC774\uB124. \uC5EC\uAE34 \uC798
      \uC548 \uC624\uB294 \uACF3\uC778\uB370."
