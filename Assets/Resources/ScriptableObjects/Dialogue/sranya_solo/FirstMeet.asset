  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uBC30\uB2EC \uB2E4\uB2C8\uB2E4 \uBCF4\uB2C8 \uBCC4 \uACF3\uC744 \uB2E4
      \uC624\uAC8C \uB418\uB124\uC694."
    choices: []
  - speaker: "\uC2A4\uB77C\uB0D0"
    text: "\uADF8\uB798\u2026 \uC870\uC2EC\uD574. \uC5EC\uAE34 \uC870\uC6A9\uD558\uC9C0\uB9CC
      \uC548\uC804\uD558\uC9C4 \uC54A\uC544."
