  entries:
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uC0C8\uBCBD\uAD6D \uAC00\uC838\uC654\uC5B4\uC694."
    choices: []
  - speaker: "\uC2A4\uB77C\uB0D0"
    text: "\u2026\uD5A5\uC774 \uC88B\uB2E4. \uC0C8\uBCBD \uB0C4\uC0C8\uAC00 \uB098."
    choices: []
  - speaker: "\uC2A4\uB77C\uB0D0"
    text: "\uACE0\uB9C8\uC6CC. \uC624\uB79C\uB9CC\uC5D0 \uB530\uB73B\uD55C \uAC78
      \uBA39\uACA0\uB124."
    choices:
    - label: "\uB9DB\uC788\uAC8C \uB4DC\uC138\uC694.\\n\uB610 \uB9CC\uB4E4\uC5B4\uC904\uAC8C\uC694."
      responses:
      - speaker: "\uC2A4\uB77C\uB0D0"
        text: "\u2026\uB2E4\uC74C\uC5D0\uB3C4 \uC640\uC918."
      resultTag: 
    - label: "\uBCC4\uAC70 \uC544\uB2C8\uC5D0\uC694.\\n\uB2E4\uC74C\uC5D0 \uB610
        \uC62C\uAC8C\uC694."
      responses:
      - speaker: "\uC2A4\uB77C\uB0D0"
        text: "\uADF8\uB798. \uB610 \uBCF4\uC790."
