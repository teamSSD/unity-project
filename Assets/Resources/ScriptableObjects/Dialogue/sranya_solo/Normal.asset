  entries:
  - speaker: "\uC2A4\uB77C\uB0D0"
    text: "\uB610 \uC654\uAD6C\uB098. \uC624\uB298\uC740 \uC5B4\uB5A4 \uBC14\uB78C\uC774
      \uBD88\uC5C8\uC5B4?"
    choices:
    - label: "\uBC30\uB2EC \uB2E4\uB2C8\uB2E4 \uB4E4\uB800\uC5B4\uC694.\\n\uC624\uB298\uB3C4
        \uBC14\uC058\uB124\uC694."
      responses:
      - speaker: "\uC2A4\uB77C\uB0D0"
        text: "\uADF8\uB798, \uBC14\uC05C \uD558\uB8E8\uACA0\uB124."
      resultTag: 
    - label: "\uADF8\uB0E5 \uC5BC\uAD74 \uBCF4\uB7EC \uC654\uC5B4\uC694.\\n\uAC00\uB054\uC740
        \uC26C\uC5B4\uC57C\uC8E0."
      responses:
      - speaker: "\uC2A4\uB77C\uB0D0"
        text: "\uADF8\uB0E5 \uC640\uC918\uC11C \uACE0\uB9C8\uC6CC."
