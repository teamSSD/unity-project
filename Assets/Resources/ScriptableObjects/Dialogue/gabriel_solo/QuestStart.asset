%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 929a58dbdcff141c4a39130b9a1497bb, type: 3}
  m_Name: QuestStart
  m_EditorClassIdentifier: Game.Runtime::DialogueSO
  entries:
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uB178\uD06C \uB450 \uBC88."
    choices: []
  - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
    text: "\u2026\uB204\uAD6C\uC57C."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uBC30\uB2EC\uC774\uC694."
    choices: []
  - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
    text: "\uBC30\uB2EC\uC774 \uC774 \uC2DC\uAC04\uC5D0?"
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uC8FC\uBB38\uD558\uC168\uC796\uC544\uC694."
    choices: []
  - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
    text: "\u2026\uD588\uB098. \uBB38\uC774 \uC5F4\uB9B0\uB2E4."
    choices: []
  - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
    text: "\uBC30\uB2EC\uAFBC \uCE58\uACE0 \uB208\uC774 \uB9D1\uB124. \uC774 \uB3D9\uB124 \uC624\uB798 \uC788\uC73C\uBA74 \uADF8\uAC83\uB3C4 \uC5C6\uC5B4\uC9C0\uB294\uB370."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uC624\uB798 \uC788\uC744 \uC0DD\uAC01\uC740 \uC5C6\uC5B4\uC694."
    choices:
    - label: "\uC624\uB798 \uC788\uC744 \uC0DD\uAC01\uC740 \uC5C6\uC5B4\uC694\n\uBC30\uB2EC \uB05D\uB098\uBA74 \uAC00\uC57C \uD558\uB2C8\uAE4C\uC694."
      responses:
      - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
        text: "\uD558, \uADF8\uB807\uACA0\uC9C0. \uB4E4\uC5B4\uC640."
      resultTag: accept
    - label: "\uC775\uC219\uD574\uC9C0\uBA74 \uB418\uC8E0\n\uBB50\uB4E0."
      responses:
      - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
        text: "\uC775\uC219\uD574\uC9C0\uB294 \uAC8C \uB2E4 \uC88B\uC740 \uAC74 \uC544\uB2C8\uC57C. \uB4E4\uC5B4\uC640."
      resultTag: accept
  - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
    text: "\uBB50 \uAC00\uC838\uC654\uC5B4."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uAE30\uACC4\uC7A5 \uACE0\uAE30\uC815\uC2DD\uC774\uC5D0\uC694. \uC624\uB798\uB41C \uACE0\uAE30 \uC190\uC9C8\uD574\uC11C \uB2E4\uC2DC \uC808\uC778 \uAC70\uC608\uC694."
    choices: []
  - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
    text: "\uC624\uB798\uB41C \uAC78 \uC190\uC9C8\uD574\uC11C. \uB0AD\uB9CC \uC5C6\uB294 \uC774\uB984\uC774\uB124."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uB0C4\uC0C8 \uB9E1\uC544\uBD10\uC694."
    choices: []
  - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
    text: "(\uB69C\uAED1 \uC5F4\uBA70) \u2026\uC5B4. \uB0C4\uC0C8\uB294 \uB0AD\uB9CC \uC788\uB124."
    choices: []
