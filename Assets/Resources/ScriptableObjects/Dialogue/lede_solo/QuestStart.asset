  m_Script: {fileID: 11500000, guid: 929a58dbdcff141c4a39130b9a1497bb, type: 3}
  m_Name: QuestStart
  m_EditorClassIdentifier: Game.Runtime::DialogueSO
  entries:
  - speaker: "\uB808\uB370"
    text: "\uBD80\uD0C1\uB4DC\uB9B4 \uAC83\uC774 \uC788\uC2B5\uB2C8\uB2E4. \uACE0\uAE30\uC815\uC2DD\uC744
      \uB9CC\uB4E4\uC5B4\uC8FC\uC2E4 \uC218 \uC788\uACA0\uC2B5\uB2C8\uAE4C?"
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uAE30\uACC4\uC7A5 \uACE0\uAE30\uC815\uC2DD\uC774\uC694?"
    choices:
    - label: "\uC900\uBE44\uD574\uC624\uACA0\uC2B5\uB2C8\uB2E4.\\n\uB9E1\uACA8\uC8FC\uC138\uC694."
      responses:
      - speaker: "\uD50C\uB808\uC774\uC5B4"
        text: "\uC900\uBE44\uD574\uC624\uACA0\uC2B5\uB2C8\uB2E4."
      - speaker: "\uB808\uB370"
        text: "\uAC10\uC0AC\uD569\uB2C8\uB2E4. \uAE30\uB2E4\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
      resultTag: accept
    - label: "\uC7A0\uC2DC \uC2DC\uAC04\uC744 \uC8FC\uC138\uC694.\\n\uC544\uC9C1
        \uC7AC\uB8CC\uAC00 \uBD80\uC871\uD574\uC11C."
      responses:
      - speaker: "\uB808\uB370"
        text: "\uAD1C\uCC2E\uC2B5\uB2C8\uB2E4. \uC900\uBE44\uAC00 \uB418\uC2DC\uBA74
          \uB9D0\uC500\uD574\uC8FC\uC138\uC694."
      resultTag: defer
