  m_Name: OrderEnd
  m_EditorClassIdentifier: Game.Runtime::DialogueSO
  entries:
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uACE0\uAE30\uC815\uC2DD \uAC00\uC838\uC654\uC2B5\uB2C8\uB2E4."
    choices: []
  - speaker: "\uB808\uB370"
    text: "\uC624\u2026 \uC815\uC131\uC774 \uB290\uAEF4\uC9C0\uB294\uAD70\uC694."
    choices: []
  - speaker: "\uB808\uB370"
    text: "\uD6CC\uB96D\uD569\uB2C8\uB2E4. \uAC10\uC0AC\uD788 \uC798 \uBA39\uACA0\uC2B5\uB2C8\uB2E4."
    choices:
    - label: "\uB9DB\uC788\uAC8C \uB4DC\uC138\uC694.\\n\uBCF4\uB78C\uCC28\uB124\uC694."
      responses:
      - speaker: "\uB808\uB370"
        text: "\uB2E4\uC74C\uC5D0\uB3C4 \uC778\uC5F0\uC774 \uB2FF\uAE38 \uBC14\uB78D\uB2C8\uB2E4."
      resultTag: 
    - label: "\uAC10\uC0AC\uD569\uB2C8\uB2E4.\\n\uC88B\uC740 \uD558\uB8E8 \uBCF4\uB0B4\uC138\uC694."
      responses:
      - speaker: "\uB808\uB370"
        text: "\uC88B\uC740 \uD558\uB8E8 \uB418\uC2ED\uC2DC\uC624."
      resultTag: 
