  m_Script: {fileID: 11500000, guid: 929a58dbdcff141c4a39130b9a1497bb, type: 3}
  m_Name: Ordering
  m_EditorClassIdentifier: Game.Runtime::DialogueSO
  entries:
  - speaker: "\uB808\uB370"
    text: "\uD639\uC2DC \uC9C4\uD589 \uC0C1\uD669\uC774 \uC5B4\uB5A0\uC2E0\uC9C0\uC694?"
    choices:
    - label: "\uAC70\uC758 \uC644\uC131\uC774\uC5D0\uC694.\\n\uACE7 \uAC00\uC838\uB2E4\uB4DC\uB9B4\uAC8C\uC694."
      responses:
      - speaker: "\uB808\uB370"
        text: "\uCC9C\uCC9C\uD788 \uD558\uC2ED\uC2DC\uC624. \uC11C\uB450\uB97C \uD544\uC694
          \uC5C6\uC2B5\uB2C8\uB2E4."
      resultTag: 
    - label: "\uC870\uAE08\uB9CC \uB354 \uAE30\uB2E4\uB824\uC8FC\uC138\uC694.\\n\uCD5C\uB300\uD55C
        \uBE68\uB9AC \uD560\uAC8C\uC694."
      responses:
      - speaker: "\uB808\uB370"
        text: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uAE30\uB2E4\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
      resultTag: 
