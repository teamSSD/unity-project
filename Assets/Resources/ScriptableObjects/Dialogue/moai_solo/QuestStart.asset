  entries:
  - speaker: "\uBAA8\uC544\uC774"
    text: "\u2026\uC2A4\uD14C\uC774\uD06C. \uBA39\uACE0 \uC2F6\uB2E4."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uC2A4\uD2B8\uB9AC\uD2B8 \uC2A4\uD14C\uC774\uD06C 49\uC694? \uACE0\uAE30
      \uC694\uB9AC\uB124\uC694."
    choices:
    - label: "\uC88B\uC544\uC694. \uB9CC\uB4E4\uC5B4\uC62C\uAC8C\uC694.\\n\uACE0\uAE30\uB294
        \uC790\uC2E0 \uC788\uC5B4\uC694."
      responses:
      - speaker: "\uD50C\uB808\uC774\uC5B4"
        text: "\uB9CC\uB4E4\uC5B4\uC62C\uAC8C\uC694."
      - speaker: "\uBAA8\uC544\uC774"
        text: "\u2026(\uAE30\uB300\uD558\uB294 \uB208\uBE5B)"
      resultTag: accept
    - label: "\uC880 \uC774\uB530\uC694.\\n\uC544\uC9C1 \uC900\uBE44\uAC00 \uB35C
        \uB410\uC5B4\uC694."
      responses:
      - speaker: "\uBAA8\uC544\uC774"
        text: "\u2026\uADF8\uB798. \uB098\uC911\uC5D0."
      resultTag: defer
