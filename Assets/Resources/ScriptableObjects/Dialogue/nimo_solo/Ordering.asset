  entries:
  - speaker: "\uB2C8\uBAA8"
    text: "\uC0BC\uAC01\uBC25! \uC0BC\uAC01\uBC25! \uC544\uC9C1\uC774\uC57C?"
    choices:
    - label: "\uAC70\uC758 \uB2E4 \uB410\uC5B4\uC694!\\n\uC870\uAE08\uB9CC \uAE30\uB2E4\uB824\uC694!"
      responses:
      - speaker: "\uB2C8\uBAA8"
        text: "\uC54C\uACA0\uC5B4! \uAE30\uB2E4\uB9AC\uB294 \uAC83\uB3C4 \uC7AC\uBC0C\uC73C\uB2C8\uAE4C!"
      resultTag: 
    - label: "\uC544\uC9C1\uC774\uC694\u2026\\n\uC880 \uB354 \uAC78\uB9B4 \uAC83
        \uAC19\uC544\uC694."
      responses:
      - speaker: "\uB2C8\uBAA8"
        text: "\uCC9C\uCC9C\uD788 \uD574\uB3C4 \uB3FC! \uADFC\uB370 \uBE68\uB9AC
