  entries:
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uC0BC\uAC01\uBC25 \uAC00\uC838\uC654\uC5B4\uC694!"
    choices: []
  - speaker: "\uB2C8\uBAA8"
    text: "\uC6B0\uC640\uC544\uC544! \uC9C4\uC9DC \uB9CC\uB4E4\uC5B4\uC654\uC5B4?!"
    choices: []
  - speaker: "\uB2C8\uBAA8"
    text: "\uB9DB\uC788\uB2E4! \uC774\uAC74 \uC9C4\uC9DC \uCD5C\uACE0\uC57C!"
    choices:
    - label: "\uB9DB\uC788\uC8E0?\\n\uC790\uC2E0\uC791\uC774\uC5D0\uC694!"
      responses:
      - speaker: "\uB2C8\uBAA8"
        text: "\uBC30\uB2EC\uAFBC \uC9F1! \uB610 \uB9CC\uB4E4\uC5B4\uC918!"
      resultTag: 
    - label: "\uB610 \uB9CC\uB4E4\uC5B4\uC904\uAC8C\uC694!\\n\uC57D\uC18D!"
      responses:
      - speaker: "\uB2C8\uBAA8"
        text: "\uB2E4\uC74C\uC5D0 \uB610 \uC62C \uAC70\uC9C0? \uC57D\uC18D\uC774\uB2E4!"
