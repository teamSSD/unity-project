  m_Script: {fileID: 11500000, guid: 929a58dbdcff141c4a39130b9a1497bb, type: 3}
  m_Name: Ordering
  m_EditorClassIdentifier: Game.Runtime::DialogueSO
  entries:
  - speaker: "\uC790\uB974"
    text: "\uC544\uC9C1\uC774\uB0D0? \uBC30\uBCF4\uB2E4 \uC131\uC9C8\uC774 \uBA3C\uC800
      \uD0C0\uACA0\uB2E4."
    choices:
    - label: "\uAC70\uC758 \uB2E4 \uB410\uC5B4\uC694\\n\uC7AC\uB8CC \uAD6C\uD574\uC624\uB294
        \uC911\uC774\uC5D0\uC694."
      responses:
      - speaker: "\uC790\uB974"
        text: "\uC88B\uC544. \uAD76\uC5B4 \uC8FD\uAE30 \uC804\uC5D0\uB9CC \uC640\uB77C."
      resultTag: 
    - label: "\uC0DD\uAC01\uBCF4\uB2E4 \uC704\uD5D8\uD558\uB124\uC694\\n\uD3D0\uC218\uC870
        \uC0C1\uD0DC\uAC00 \uC548 \uC88B\uC544\uC694."
      responses:
      - speaker: "\uC790\uB974"
        text: "\uC704\uD5D8\uD558\uC9C0 \uC54A\uC740 \uACF5\uB2E8\uC774 \uC5B4\uB528\uB0D0."
      resultTag: 
  - speaker: "\uAC8C\uD1A0\uB85C"
    text: "\uC804\uB825\uC2E4 \uC628\uB3C4 \uC720\uC9C0 \uC911. \uB300\uAE30 \uAC00\uB2A5
      \uC2DC\uAC04 \uACC4\uC0B0 \uC911\uC785\uB2C8\uB2E4."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uAE30\uB2E4\uB824\uC918\uC11C \uACE0\uB9C8\uC6CC\uC694."
    choices: []
  - speaker: "\uAC8C\uD1A0\uB85C"
    text: "\uC8FC\uBB38\uC740 \uC2E0\uB8B0\uC758 \uC5F0\uC0B0\uC785\uB2C8\uB2E4."
    choices: []
