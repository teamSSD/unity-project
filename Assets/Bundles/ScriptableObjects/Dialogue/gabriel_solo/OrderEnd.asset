%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 929a58dbdcff141c4a39130b9a1497bb, type: 3}
  m_Name: OrderEnd
  m_EditorClassIdentifier: Game.Runtime::DialogueSO
  entries:
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uC811\uC2DC\uAC00 \uAC70\uC758 \uBE44\uC6CC\uC9C4\uB2E4."
    choices: []
  - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
    text: "\uB2E4 \uBA39\uC5C8\uB2E4. \u2026\uC624\uB79C\uB9CC\uC774\uB124, \uC774\uB807\uAC8C."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uC6D0\uB798 \uC798 \uC548 \uB4DC\uC138\uC694?"
    choices: []
  - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
    text: "\uBA39\uAE34 \uBA39\uC5B4. \uB2E4 \uBA39\uB294 \uAC74 \uC880 \uB2EC\uB77C. \uB2E4 \uBA39\uC73C\uBA74 \uB2E4\uC74C\uC774 \uC640\uBC84\uB9AC\uAC70\uB4E0."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uB2E4\uC74C\uC774\uC694?"
    choices: []
  - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
    text: "\uB2E4\uC74C \uB07C\uB2C8. \uB2E4\uC74C \uB0A0. \uBB50, \uADF8\uB7F0 \uAC83\uB4E4."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uADF8\uAC8C \uC2EB\uC5B4\uC694?"
    choices:
    - label: "\uADF8\uAC8C \uC2EB\uC5B4\uC694?\n\uB2E4\uC74C\uC774 \uC624\uB294 \uAC8C\uC694."
      responses:
      - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
        text: "\uC2EB\uB2E4\uAE30\uBCF4\uB2E4\u2026 \uC880 \uBB34\uAC8C\uAC10\uC774 \uC788\uC5B4."
      - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
        text: "\uADFC\uB370 \uC624\uB298\uC740 \uBB50, \uB2E4\uC74C\uC774 \uC640\uB3C4 \uB420 \uAC83 \uAC19\uAE30\uB3C4 \uD558\uACE0."
      - speaker: "\uD50C\uB808\uC774\uC5B4"
        text: "\uADF8\uB7FC \uB410\uB124\uC694."
      - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
        text: "\u2026\uADF8\uB7EC\uB124."
      resultTag: 
    - label: "\uB610 \uC62C\uAC8C\uC694\n\uC8FC\uBB38\uD558\uBA74\uC694."
      responses:
      - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
        text: "\uC5B4."
      - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
        text: "\uC624\uB298\uC740 \uBB50, \uB2E4\uC74C\uC774 \uC640\uB3C4 \uB420 \uAC83 \uAC19\uAE30\uB3C4 \uD558\uACE0."
      - speaker: "\uD50C\uB808\uC774\uC5B4"
        text: "\uB2E4\uC74C\uC5D0 \uB610 \uB2E4 \uB4DC\uC138\uC694."
      - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
        text: "\uBD10\uAC00\uBA70."
      resultTag: 
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uB610 \uC8FC\uBB38\uD558\uBA74 \uC62C\uAC8C\uC694."
    choices: []
  - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
    text: "\uC5B4. \u2026\uB178\uD06C \uB450 \uBC88 \uAE30\uC5B5\uD574."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uC138 \uBC88 \uD558\uBA74 \uC548 \uC5F4\uC5B4\uC900\uB2E4\uACE0\uC694."
    choices: []
  - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
    text: "\uB450 \uBC88\uC774\uB791 \uC138 \uBC88 \uC0AC\uC774\uC5D0 \uBB54\uAC00 \uC788\uAC70\uB4E0."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uBB54\uB370\uC694."
    choices: []
  - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
    text: "\uADF8\uAC74 \uB450 \uBC88 \uD588\uC744 \uB54C \uC54C \uC218 \uC788\uC9C0."
    choices: []
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uBB38\uC774 \uB2EB\uD78C\uB2E4. \uC704\uC5D0\uC11C \uC545\uBCF4 \uB118\uAE30\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4."
    choices: []
