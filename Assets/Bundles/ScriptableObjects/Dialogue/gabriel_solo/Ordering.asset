%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 929a58dbdcff141c4a39130b9a1497bb, type: 3}
  m_Name: Ordering
  m_EditorClassIdentifier: Game.Runtime::DialogueSO
  entries:
  - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
    text: "\uB108 \uC74C\uC545 \uB4E4\uC5B4?"
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uAC00\uB054\uC694."
    choices: []
  - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
    text: "\uAC00\uB054. \uC88B\uC740 \uB300\uB2F5\uC774\uC57C. \uD56D\uC0C1 \uB4E3\uB294\uB2E4\uB294 \uB188\uCE58\uACE0 \uC81C\uB300\uB85C \uB4E3\uB294 \uB188 \uC5C6\uAC70\uB4E0."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uAC00\uBE0C\uB9AC\uC5D8 \uC528\uB294\uC694?"
    choices:
    - label: "\uAC00\uBE0C\uB9AC\uC5D8 \uC528\uB294\uC694?\n\uC694\uC998\uB3C4 \uB4E4\uC5B4\uC694?"
      responses:
      - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
        text: "\uB098\uB294 \uC694\uC998 \uC548 \uB4E4\uC5B4. \uB4E4\uC73C\uBA74 \uC190\uC774 \uC6C0\uC9C1\uC774\uAC70\uB4E0. \uADF8\uAC8C \uADC0\uCC2E\uC544\uC11C."
      - speaker: "\uD50C\uB808\uC774\uC5B4"
        text: "\uC190\uC774 \uC6C0\uC9C1\uC774\uBA74 \uC65C \uADC0\uCC2E\uC544\uC694."
      - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
        text: "\uC6C0\uC9C1\uC774\uBA74 \uBB54\uAC00 \uB9CC\uB4E4\uC5B4\uC57C \uD560 \uAC83 \uAC19\uC796\uC544. \uB9CC\uB4E4\uBA74 \uB4E4\uB824\uC918\uC57C \uD560 \uAC83 \uAC19\uACE0. \uB4E4\uB824\uC8FC\uBA74\u2026 \uC218\uACE0\uC2A4\uB7EC\uC6CC\uC9C0\uAC70\uB4E0."
      resultTag: 
    - label: "\uC800 \uC545\uBCF4 \uB2E4 \uC4F4 \uAC70\uC608\uC694?\n\uBCBD\uC5D0 \uBD99\uC740 \uAC70\uC694."
      responses:
      - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
        text: "\uC61B\uB0A0\uC5D0. \uC9C0\uAE08\uC740 \uADF8\uB0E5 \uBCBD\uC9C0\uC57C."
      - speaker: "\uD50C\uB808\uC774\uC5B4"
        text: "\uBC84\uB9AC\uBA74 \uB418\uC796\uC544\uC694."
      - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
        text: "\uBC84\uB9AC\uBA74 \uC9C4\uC9DC \uBCBD\uC9C0\uAC00 \uB418\uC796\uC544. \uC9C0\uAE08\uC740 \uADF8\uB798\uB3C4 \uC545\uBCF4\uB2C8\uAE4C."
      resultTag: 
  - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
    text: "\uC61B\uB0A0\uC5D0 \uACF5\uC5F0\uD560 \uB54C\u2026 \uB9E8 \uC55E\uC904\uC5D0 \uD56D\uC0C1 \uAC19\uC740 \uC0AC\uB78C\uC774 \uC788\uC5C8\uC5B4. \uB9E4\uBC88 \uC654\uB294\uB370 \uD55C \uBC88\uB3C4 \uB9D0 \uAC74 \uC801 \uC5C6\uC5B4. \uADFC\uB370 \uADF8 \uC0AC\uB78C \uC5C6\uB294 \uB0A0\uC740 \uACF5\uC5F0\uC774 \uC880 \uB2EC\uB790\uC5B4."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uC5B4\uB5BB\uAC8C \uB2EC\uB790\uC5B4\uC694?"
    choices:
    - label: "\uC5B4\uB5BB\uAC8C \uB2EC\uB790\uC5B4\uC694?\n\uC18C\uB9AC\uAC00 \uB2EC\uB77C\uC838\uC694?"
      responses:
      - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
        text: "\uC18C\uB9AC\uB294 \uB611\uAC19\uC558\uB294\uB370. \u2026\uBC29\uD5A5\uC774 \uC5C6\uC5C8\uB2E4\uACE0 \uD574\uC57C \uD558\uB098."
      resultTag: 
    - label: "\uC9C0\uAE08\uB3C4 \uADF8 \uC0AC\uB78C \uC640\uC694?\n\uC544\uC9C1 \uC5F0\uB77D\uD574\uC694?"
      responses:
      - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
        text: "\uACF5\uC5F0\uC774 \uC5C6\uB294\uB370 \uC5B4\uB5BB\uAC8C \uC640. \uB0B4\uAC00 \uC5C6\uC560\uBC84\uB838\uAC70\uB4E0, \uACF5\uC5F0\uC744."
      - speaker: "\uD50C\uB808\uC774\uC5B4"
        text: "\uC65C\uC694."
      - speaker: "\uAC00\uBE0C\uB9AC\uC5D8"
        text: "\uBB50, \uC5EC\uB7EC \uAC00\uC9C0."
      resultTag: 
