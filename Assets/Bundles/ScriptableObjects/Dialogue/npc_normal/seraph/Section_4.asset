  entries:
  - speaker: "\uC138\uB77C\uD504"
    text: "\uC2AC\uB7FC\uC740 \uBE44\uD6A8\uC728\uC801\uC774\uB77C\uACE0\uB4E4 \uB9D0\uD569\uB2C8\uB2E4."
    choices: []
  - speaker: "\uC138\uB77C\uD504"
    text: "...\uD558\uC9C0\uB9CC \uD6A8\uC728\uB9CC\uC73C\uB85C \uC720\uC9C0\uB418\uB294
      \uB3C4\uC2DC\uB294 \uC5C6\uB354\uAD70\uC694."
    choices: []
  - speaker: "\uC138\uB77C\uD504"
    text: "...\uB3C4\uC2DC\uB294 \uC5B4\uB5BB\uAC8C\uB4E0 \uAD74\uB7EC\uAC11\uB2C8\uB2E4."
