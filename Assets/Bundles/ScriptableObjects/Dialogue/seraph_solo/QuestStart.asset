  m_Script: {fileID: 11500000, guid: 929a58dbdcff141c4a39130b9a1497bb, type: 3}
  m_Name: QuestStart
  m_EditorClassIdentifier: Game.Runtime::DialogueSO
  entries:
  - speaker: "\uC138\uB77C\uD504"
    text: "\uC2E4\uB840\uD569\uB2C8\uB2E4. \uC790\uB9AC \uAD1C\uCC2E\uC744\uAE4C\uC694?"
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uC549\uC73C\uC138\uC694."
    choices: []
  - speaker: "\uC138\uB77C\uD504"
    text: "\uCC44\uC18C \uC704\uC8FC\uB85C \uBD80\uD0C1\uB4DC\uB824\uB3C4 \uB420\uAE4C\uC694. \uC624\uB298\uC740 \uBB34\uAC70\uC6B4 \uAC8C \uBCC4\uB85C\uB77C\uC11C\uC694."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uC5B4\uB5A4 \uAC8C \uC88B\uC544\uC694?"
    choices:
    - label: "\uB124\uC628 \uC0D0\uB7EC\uB4DC \uC788\uC5B4\uC694\n\uCC44\uC18C \uC704\uC8FC\uBA74 \uB531 \uB9DE\uB294 \uAC8C \uC788\uC5B4\uC694."
      responses:
      - speaker: "\uC138\uB77C\uD504"
        text: "\uC88B\uC2B5\uB2C8\uB2E4. \uADF8\uAC78\uB85C \uD560\uAC8C\uC694."
      - speaker: "\uD50C\uB808\uC774\uC5B4"
        text: "\uC7A0\uAE50 \uAE30\uB2E4\uB9AC\uC138\uC694."
      resultTag: accept
    - label: "\uC5B4\uB5A4 \uAC8C \uC88B\uC544\uC694?\n\uC870\uAE08 \uB354 \uAD6C\uCCB4\uC801\uC73C\uB85C \uB9D0\uD574\uC918\uC694."
      responses:
      - speaker: "\uC138\uB77C\uD504"
        text: "\uAC00\uBCCD\uACE0, \uD5A5\uC774 \uC788\uB294 \uAC78\uB85C\uC694. \uC624\uB298 \uB0C4\uC0C8\uAC00 \uC880 \uB9CE\uC774 \uB9E1\uC544\uC11C\uC694."
      - speaker: "\uD50C\uB808\uC774\uC5B4"
        text: "\uB124\uC628 \uC0D0\uB7EC\uB4DC\uBA74 \uB420 \uAC83 \uAC19\uB124\uC694."
      - speaker: "\uC138\uB77C\uD504"
        text: "\uBBFF\uC744\uAC8C\uC694."
      resultTag: accept
