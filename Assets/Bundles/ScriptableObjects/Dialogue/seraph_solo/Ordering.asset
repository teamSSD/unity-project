%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 929a58dbdcff141c4a39130b9a1497bb, type: 3}
  m_Name: Ordering
  m_EditorClassIdentifier: Game.Runtime::DialogueSO
  entries:
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uB8E8\uBBF8\uC78E\uACFC \uCC44\uC18C\uB97C \uC11E\uC73C\uBA70 \uC0C9 \uB300\uBE44\uB97C \uB9CC\uB4E0\uB2E4."
    choices: []
  - speaker: "\uC138\uB77C\uD504"
    text: "\uC5EC\uAE30 \uC624\uB294 \uAC8C \uBC8C\uC368 \uC138 \uBC88\uC9F8\uC778\uB370, \uBA54\uB274\uD310\uC740 \uC624\uB298 \uCC98\uC74C \uBCF4\uB124\uC694."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uADF8\uB0E5 \uB2EC\uB77C\uB294 \uB300\uB85C \uB4DC\uB838\uAC70\uB4E0\uC694."
    choices: []
  - speaker: "\uC138\uB77C\uD504"
    text: "\uB9DE\uC544\uC694. \uADF8\uAC8C \uD3B8\uD588\uC5B4\uC694."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uC774 \uADFC\uCC98\uC5D0 \uC77C\uC774 \uC788\uC5B4\uC694?"
    choices:
    - label: "\uC774 \uADFC\uCC98\uC5D0 \uC77C\uC774 \uC788\uC5B4\uC694?\n\uC790\uC8FC \uBCF4\uC774\uB358\uB370."
      responses:
      - speaker: "\uC138\uB77C\uD504"
        text: "\uCD9C\uC7A5\uC774\uC5D0\uC694. \uC880 \uAE38\uC5B4\uC9C0\uACE0 \uC788\uC5B4\uC694."
      - speaker: "\uD50C\uB808\uC774\uC5B4"
        text: "\uBB34\uC2A8 \uC77C\uC774\uC5D0\uC694?"
      - speaker: "\uC138\uB77C\uD504"
        text: "\uC11C\uB958 \uC77C\uC774\uC5D0\uC694. \uC7AC\uBBF8\uC5C6\uB294 \uC885\uB958\uC758."
      resultTag: 
    - label: "\uC5EC\uAE30 \uC74C\uC2DD\uC774 \uC785\uC5D0 \uB9DE\uC544\uC694?\n\uC678\uC9C0\uAD6C \uBD84\uD55C\uD14C\uB294 \uB0AF\uC124 \uC218 \uC788\uB294\uB370."
      responses:
      - speaker: "\uC138\uB77C\uD504"
        text: "\uC138\uB828\uB418\uC9C0 \uC54A\uC558\uB294\uB370, \uBB18\uD558\uAC8C \uD3B8\uC548\uD569\uB2C8\uB2E4."
      - speaker: "\uD50C\uB808\uC774\uC5B4"
        text: "\uC138\uB828\uB41C \uB370\uC11C \uB4DC\uC2DC\uBA74 \uB418\uC796\uC544\uC694."
      - speaker: "\uC138\uB77C\uD504"
        text: "\uADF8\uB807\uC8E0."
      resultTag: 
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uC5F0\uB450\uCF69\uC744 \uADF8\uC744\uB9B0\uB2E4. \uB808\uBAAC\uB4DC\uB798\uC2A4 \uB4DC\uB808\uC2F1. \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC804\uAE30\uAF43\uC744 \uC62C\uB9B0\uB2E4."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uC804\uAE30\uAF43\uC774 \uB4E4\uC5B4\uAC00\uC694. \uAE08\uC18D \uD3EC\uD06C \uC4F0\uBA74 \uC785\uC548\uC5D0 \uC0B4\uC9DD \uCC0C\uB9BF\uD560 \uC218 \uC788\uC5B4\uC694."
    choices: []
  - speaker: "\uC138\uB77C\uD504"
    text: "\uAD1C\uCC2E\uC2B5\uB2C8\uB2E4."
    choices: []
