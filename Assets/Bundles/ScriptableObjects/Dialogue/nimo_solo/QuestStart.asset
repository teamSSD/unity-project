%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 929a58dbdcff141c4a39130b9a1497bb, type: 3}
  m_Name: QuestStart
  m_EditorClassIdentifier: Game.Runtime::DialogueSO
  entries:
  - speaker: "\uB2C8\uBAA8"
    text: "\uC654\uC5B4, \uC654\uC5B4. \uC624\uB298 \uB531 \uB9DE\uC9C0? \uC6B4\uD558 \uC548\uAC1C \uB54C\uBB38\uC5D0 \uC880 \uB3CC\uC544\uC654\uB294\uB370 \uADF8\uB798\uB3C4 4\uC2DC \uB9DE\uC9C0?"
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "4\uC2DC 1\uBD84."
    choices: []
  - speaker: "\uB2C8\uBAA8"
    text: "1\uBD84\uC740 \uC624\uCC28\uBC94\uC704\uC57C. \uC544, \uC624\uB298 \uD574\uCD08 \uC0C1\uD0DC \uC9C4\uC9DC \uC88B\uC544\u2026 \uB0C4\uC0C8 \uB9E1\uC544\uBCFC\uB798?"
    choices: []
  - speaker: "\uB2C8\uBAA8"
    text: "\uC544, \uC774\uAC70\u2026 \uC0C8\uBCBD\uD480\uC774\uC57C. \uCC28\uAD11 \uD3EC\uC7A5 \uADF8\uB300\uB85C \uC368. \uBE5B \uB4E4\uC5B4\uAC00\uBA74 \uD5A5 \uB0A0\uC544\uAC00. \uBE68\uB9AC \uC368\uC57C \uD574."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uC7A0\uAE50 \uC788\uC5B4\uC694."
    choices:
    - label: "\uC7A0\uAE50 \uC788\uC5B4\uC694\n\uAD6D \uB053\uC774\uB294 \uB3D9\uC548\uC694."
      responses:
      - speaker: "\uB2C8\uBAA8"
        text: "\u2026\uC5B4, \uB098?"
      - speaker: "\uD50C\uB808\uC774\uC5B4"
        text: "\uBC25\uC740 \uBA39\uACE0 \uAC00\uC57C\uC8E0."
      - speaker: "\uB2C8\uBAA8"
        text: "\uC544, \uBB50\u2026 \uADF8\uB7FC \uC9E7\uAC8C\uB9CC. \uC624\uC804 \uC7A5 \uC804\uC5D0 \uB8E8\uD2B8 \uC788\uAC70\uB4E0."
      resultTag: accept
    - label: "\uC0C8\uBCBD\uD480 \uAE08\uBC29 \uC4F8\uAC8C\uC694\n\uBC14\uB85C \uC2DC\uC791\uD560\uAC8C\uC694."
      responses:
      - speaker: "\uB2C8\uBAA8"
        text: "\uADF8\uB807\uC9C0, \uBE68\uB9AC\uBE68\uB9AC! \uD5A5 \uB0A0\uC544\uAC00\uAE30 \uC804\uC5D0!"
      - speaker: "\uD50C\uB808\uC774\uC5B4"
        text: "\uBC25\uB3C4 \uD574\uB4DC\uB9B4\uAC8C\uC694."
      - speaker: "\uB2C8\uBAA8"
        text: "\uC544 \uBB50\u2026 \uADF8\uB7FC \uC7A0\uAE50\uB9CC."
      resultTag: accept
