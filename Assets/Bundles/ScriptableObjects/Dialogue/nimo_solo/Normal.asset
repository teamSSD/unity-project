  entries:
  - speaker: "\uB2C8\uBAA8"
    text: "\uC654\uB2E4\uC654\uB2E4! \uC624\uB298\uC740 \uBB50 \uAC00\uC838\uC654\uC5B4?"
    choices:
    - label: "\uC624\uB298\uC740 \uAD6C\uACBD\uC774\uC5D0\uC694.\\n\uAC00\uB054\uC740
        \uC26C\uC5B4\uC57C\uC8E0."
      responses:
      - speaker: "\uB2C8\uBAA8"
        text: "\uC5D0\uC774~ \uADF8\uB798\uB3C4 \uC640\uC92C\uC796\uC544! \uACE0\uB9C8\uC6CC!"
      resultTag: 
    - label: "\uBC30\uB2EC \uC654\uB2E4\uAC00\uC694.\\n\uADFC\uCC98 \uC9C0\uB098\uB294
        \uAE38\uC774\uC5D0\uC694."
      responses:
      - speaker: "\uB2C8\uBAA8"
        text: "\uAD1C\uCC2E\uC544\uAD1C\uCC2E\uC544! \uB2E4\uC74C\uC5D0 \uBB50 \uB9DB\uC788\uB294
          \uAC70 \uAE30\uB300\uD560\uAC8C!"
      resultTag: 
