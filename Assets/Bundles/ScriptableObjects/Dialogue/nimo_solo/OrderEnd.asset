%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 929a58dbdcff141c4a39130b9a1497bb, type: 3}
  m_Name: OrderEnd
  m_EditorClassIdentifier: Game.Runtime::DialogueSO
  entries:
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uC0C8\uBCBD\uAD6D\uC774 \uC644\uC131\uB41C\uB2E4. \uB450\uBD80\uAC00 \uC62C\uB77C\uAC04\uB2E4."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uBA39\uC5B4\uC694."
    choices: []
  - speaker: "\uB2C8\uBAA8"
    text: "\uB098? \uBA39\uC5B4\uB3C4 \uB3FC?"
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uC549\uC544\uC694."
    choices: []
  - speaker: "\uB2C8\uBAA8"
    text: "\uACE0\uB9C8\uC6CC, \uC9C4\uC9DC\uB85C. \uC0C8\uBCBD\uC5D0 \uC6B4\uD558 \uB3CC\uBA74 \uBC30\uAC00 \uC9C4\uC9DC \uACE0\uD508\uB370 \uB4DC\uB860\uC120\uC5D4 \uC721\uD3EC\uB791 \uCE94 \uC74C\uB8CC\uBC16\uC5D0 \uC5C6\uAC70\uB4E0."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uBA39\uC73C\uBA74\uC11C \uB9D0\uD574\uC694."
    choices: []
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uCCAB \uC21F\uAC00\uB77D."
    choices: []
  - speaker: "\uB2C8\uBAA8"
    text: "\uB530\uB73B\uD558\uB2E4."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uBC25\uC740 \uC5B4\uB514\uC11C \uBA39\uC5B4\uC694, \uBCF4\uD1B5."
    choices:
    - label: "\uB9E4\uC77C \uC774 \uC2DC\uAC04\uC5D0 \uC624\uBA74\uC11C\n\uBC25\uC740 \uC5B4\uB514\uC11C \uBA39\uC5B4\uC694, \uBCF4\uD1B5."
      responses:
      - speaker: "\uB2C8\uBAA8"
        text: "\uAC70\uC758 \uBABB \uBA39\uC5B4. \uC624\uC804 \uC7A5 \uB05D\uB098\uACE0 \uC9D1 \uAC00\uBA74 \uADF8\uB54C \uBA39\uB294\uB370\u2014 \uADF8\uAC8C \uC810\uC2EC\uC774\uC57C, \uC0AC\uC2E4."
      - speaker: "\uD50C\uB808\uC774\uC5B4"
        text: "\uADF8\uB7FC \uC624\uB298 \uC774\uAC8C \uCCAB \uB07C\uB124\uC694."
      - speaker: "\uB2C8\uBAA8"
        text: "\u2026\uADF8\uB7EC\uB124. \uCCAB \uB07C. \uADF8\uB7EC\uB124."
      resultTag: 
    - label: "\uC624\uB298 \uC0C8\uBCBD\uD480 \uC0C1\uD0DC \uC88B\uC558\uC5B4\uC694\n\uD5A5\uC774 \uB2EC\uB790\uC5B4\uC694."
      responses:
      - speaker: "\uB2C8\uBAA8"
        text: "\uADF8\uB807\uC9C0? \uB0B4\uAC00 \uACE8\uB790\uC73C\uB2C8\uAE4C. \uC6B4\uD558 \uC548\uCABD \uADF8\uB298\uC5D0\uC11C \uC790\uB780 \uAC70\uC57C. \uBE5B\uC774 \uAC70\uC758 \uC548 \uB2FF\uC740 \uAC70\uB77C \uD5A5\uC774 \uB354 \uC9C4\uD574."
      - speaker: "\uD50C\uB808\uC774\uC5B4"
        text: "\uADF8\uAC78 \uC5B4\uB5BB\uAC8C \uC54C\uC544\uC694."
      - speaker: "\uB2C8\uBAA8"
        text: "\uB098 \uC6D0\uB798 \uADF8\uB7F0 \uAC70 \uC798 \uCC3E\uC544. \uC228\uC5B4\uC788\uB294 \uAC70."
      resultTag: 
  - speaker: "\uB2C8\uBAA8"
    text: "\uBB4D\uC5D0 \uC788\uC73C\uBA74 \uB2E4\uB4E4 \uC228\uC744 \uCC38\uB294 \uAC83 \uAC19\uC544. \uB098\uB3C4 \uADF8\uB7F0 \uAC83 \uAC19\uACE0. \uADFC\uB370 \uC774\uAC70 \uBA39\uC73C\uBA74\u2014 \uC7A0\uAE50 \uB0B4\uB824\uB193\uAC8C \uB418\uB294 \uAC83 \uAC19\uC544."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uC544\uC694."
    choices:
    - label: "\uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uC544\uC694"
      responses:
      - speaker: "\uB2C8\uBAA8"
        text: "\u2026\uADF8\uB7FC \uB2E4\uC74C\uC5D4 \uC880 \uB354 \uD574\uBCFC\uAC8C."
      resultTag: 
    - label: "\uADF8\uB7F0 \uB9D0\uB3C4 \uD574\uC694\n\uAC00\uB054\uC740."
      responses:
      - speaker: "\uB2C8\uBAA8"
        text: "\uADF8\uB7EC\uBA74 \uB3FC?"
      - speaker: "\uD50C\uB808\uC774\uC5B4"
        text: "\uC5EC\uAE30\uC120\uC694."
      - speaker: "\uB2C8\uBAA8"
        text: "\u2026\uC54C\uACA0\uC5B4. \uAE30\uC5B5\uD574\uB458\uAC8C."
      resultTag: 
  - speaker: "\uB2C8\uBAA8"
    text: "(\uC77C\uC5B4\uB098\uBA70) \uC790, \uB098 \uC774\uC81C \uC9C4\uC9DC \uAC00\uC57C \uD574. \uB2E4\uC74C \uC8FC\uC5D4 \uC0C8\uBCBD\uD480 \uB450 \uBB36\uC74C \uAC00\uC838\uC62C\uAC8C."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uB450 \uBB36\uC74C\uC774\uC694?"
    choices: []
  - speaker: "\uB2C8\uBAA8"
    text: "\uD558\uB098\uB294 \uBE5B\uC5D0 \uB450\uBA74 \uC5B4\uB5BB\uAC8C \uB418\uB294\uC9C0 \uC2E4\uD5D8\uC6A9\uC73C\uB85C. \uC5B4\uB5BB\uAC8C \uC0AC\uB77C\uC9C0\uB294\uC9C0\u2014 \uD55C\uBC88\uCBE4 \uBD10\uB3C4 \uB418\uC796\uC544."
    choices: []
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uB4DC\uB860\uC120 \uC2DC\uB3D9 \uC18C\uB9AC. \uB3D9\uCABD\uC774 \uC870\uAE08\uC529 \uBC1D\uC544\uC628\uB2E4."
    choices: []
