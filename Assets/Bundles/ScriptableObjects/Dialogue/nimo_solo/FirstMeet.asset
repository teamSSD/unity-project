  entries:
  - speaker: "\uB2C8\uBAA8"
    text: "\uC624! \uC0C8 \uC0AC\uB78C\uC774\uB2E4! \uC5EC\uAE30 \uC0AC\uB78C \uC548
      \uC624\uB294\uB370!"
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uBC30\uB2EC \uC654\uC5B4\uC694. \uC5EC\uAE30\uB3C4 \uBC30\uB2EC \uAD6C\uC5ED\uC774\uB77C\uC11C."
    choices: []
  - speaker: "\uB2C8\uBAA8"
    text: "\uB300\uBC15! \uBC30\uB2EC\uC774 \uC5EC\uAE30\uAE4C\uC9C0 \uC640? \uC138\uC0C1
      \uC88B\uC544\uC84C\uB2E4!"
