%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 929a58dbdcff141c4a39130b9a1497bb, type: 3}
  m_Name: Ordering
  m_EditorClassIdentifier: Game.Runtime::DialogueSO
  entries:
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uB2ED\uBF08 \uC721\uC218\uAC00 \uB053\uAE30 \uC2DC\uC791\uD55C\uB2E4."
    choices: []
  - speaker: "\uB2C8\uBAA8"
    text: "\uADF8\uB098\uC800\uB098 \uB098 \uC774\uBC88 \uB2EC\uC5D0 \uC218\uC1A1\uC120 \uC5C5\uADF8\uB808\uC774\uB4DC \uC54C\uC544\uBCF4\uACE0 \uC788\uC5B4."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uC9C0\uAE08 \uAC83\uB3C4 \uC5BC\uB9C8 \uC548 \uB410\uC796\uC544\uC694."
    choices: []
  - speaker: "\uB2C8\uBAA8"
    text: "3\uB144 \uB410\uC5B4, 3\uB144! \uC6B4\uD558\uC5D0\uC11C 3\uB144\uC774\uBA74 \uAC70\uC758 \uB178\uC778\uC774\uB77C\uACE0. \uC870\uB9CC\uAC04 \uB354 \uD070 \uC218\uC1A1\uC120\uC744 \uC0AC\uACE0\uC57C \uB9D0\uD14C\uC57C."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uB3C8\uC740 \uC788\uC5B4\uC694?"
    choices:
    - label: "\uB3C8\uC740 \uC788\uC5B4\uC694?\n\uC218\uC1A1\uC120\uC774 \uC5BC\uB9CC\uB370\uC694."
      responses:
      - speaker: "\uB2C8\uBAA8"
        text: "\uADF8\uAC78 \uC54C\uBA74 \uC774\uBBF8 \uC0C0\uACA0\uC9C0. \uC9C0\uAE08 \uBAA8\uC73C\uB294 \uC911\uC774\uC57C."
      resultTag: 
    - label: "\uC9C0\uAE08 \uAC83\uB3C4 \uC798 \uC4F0\uB358\uB370\n\uB531\uD788 \uBD88\uD3B8\uD574 \uBCF4\uC774\uC9C4 \uC54A\uC558\uB294\uB370."
      responses:
      - speaker: "\uB2C8\uBAA8"
        text: "\uB0B4\uAC00 \uBD88\uD3B8\uD55C \uAC70\uC57C! \uC0DD\uC120\uC774 \uC544\uB2C8\uB77C."
      resultTag: 
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uBC84\uC12F\uAC00\uB8E8\uAC00 \uB4E4\uC5B4\uAC00\uBA70 \uC7A1\uB0B4\uAC00 \uC7A1\uD78C\uB2E4."
    choices: []
  - speaker: "\uB2C8\uBAA8"
    text: "\uC800\uAC70 \uB0B4\uAC00 \uACE0\uB978 \uBC84\uC12F\uAC00\uB8E8 \uB9DE\uC9C0?"
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uB9DE\uC544\uC694."
    choices: []
  - speaker: "\uB2C8\uBAA8"
    text: "\uC88B\uC544. \uC2DC\uC7A5 \uAC70\uB791 \uAC74\uC870 \uC628\uB3C4\uAC00 \uB2EC\uB77C. \uC9C1\uC811 \uB9D0\uB9B0 \uAC70\uAC70\uB4E0."
    choices: []
  - speaker: "\uB2C8\uBAA8"
    text: "\uC790, \uC0C8\uBCBD\uD480\u2026 \uC9C4\uC9DC \uBE68\uB9AC \uC368\uC57C \uD574."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uBD88 \uB04C\uAC8C\uC694."
    choices: []
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uBD88\uC744 \uB044\uACE0 \uC0C8\uBCBD\uD480\uC744 \uB123\uB294\uB2E4. \uD5A5\uC774 \uD655 \uD37C\uC9C4\uB2E4."
    choices: []
  - speaker: "\uB2C8\uBAA8"
    text: "\u2026\uC624, \uC774\uAC70\uB2E4."
    choices: []
