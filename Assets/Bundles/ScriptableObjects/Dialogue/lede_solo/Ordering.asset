%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 929a58dbdcff141c4a39130b9a1497bb, type: 3}
  m_Name: Ordering
  m_EditorClassIdentifier: Game.Runtime::DialogueSO
  entries:
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uD751\uBBF8\uBC25\uC744 \uD3B8\uB2E4. \uC808\uC778 \uAC00\uC9C0\uC640 \uCCAD\uC591\uC78E \uC808\uC784\uC744 \uC18D\uC73C\uB85C \uB123\uB294\uB2E4."
    choices: []
  - speaker: "\uB808\uB370"
    text: "\uC774\uAC70 \uD751\uBBF8\uC57C? \uBC25\uC774 \uC774\uB807\uAC8C \uAC80\uC5B4\uB3C4 \uB3FC?"
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uBA39\uC5B4\uBCF4\uBA74 \uC54C\uC544\uC694."
    choices: []
  - speaker: "\uB808\uB370"
    text: "\uC774 \uBE68\uAC04 \uAC70\uB294 \uBB50\uC57C\u2026"
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uCCAD\uC591\uC78E \uC808\uC784\uC774\uC5D0\uC694. \uC18D\uC7AC\uB8CC\uC608\uC694. \uC870\uAE08 \uB9E4\uC6CC\uC694."
    choices: []
  - speaker: "\uB808\uB370"
    text: "\uC88B\uC544. \uB098 \uB9E4\uC6B4 \uAC70 \uC88B\uC544\uD558\uAC70\uB4E0."
    choices: []
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uC7BF\uBE5B \uAC04\uC7A5\uC744 \uC190\uC73C\uB85C \uBC14\uB974\uBA70 \uC0BC\uAC01\uD615\uC73C\uB85C \uC954\uB2E4."
    choices: []
  - speaker: "\uB808\uB370"
    text: "\uC190\uC73C\uB85C \uD574? \uB3C4\uAD6C \uC5C6\uC5B4?"
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uC190\uC774 \uB3C4\uAD6C\uC608\uC694."
    choices: []
  - speaker: "\uB808\uB370"
    text: "\uBA4B\uC788\uB294 \uCC99\uD558\uC9C0 \uB9C8."
    choices: []
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uC2E0\uBB38\uC9C0 \uD3EC\uC77C\uB85C \uC0BC\uAC01\uBC25\uC744 \uC2FC\uB2E4."
    choices: []
  - speaker: "\uB808\uB370"
    text: "\uC57C, \uADF8\uAC70 \uC2E0\uBB38\uC9C0\uC57C?"
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uD3D0\uC1C4\uB41C \uC778\uC1C4\uC18C\uC5D0\uC11C \uB098\uC628 \uD3EC\uC77C\uC774\uC5D0\uC694."
    choices: []
  - speaker: "\uB808\uB370"
    text: "\u2026C\uAD6C\uC5ED \uAC70?"
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uAC70\uAE30\uC11C \uAD6C\uD588\uC5B4\uC694."
    choices: []
  - speaker: "\uB808\uB370"
    text: "\uC544, \uADF8\uB798? \uB098\uB3C4 \uAC70\uAE30 \uC790\uC8FC \uAC14\uAC70\uB4E0. \uC885\uC774 \uB0C4\uC0C8 \uC88B\uC796\uC544. \uC61B\uB0A0\uC5D0."
    choices: []
