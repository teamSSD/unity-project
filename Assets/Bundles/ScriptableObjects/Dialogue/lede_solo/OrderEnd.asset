%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 929a58dbdcff141c4a39130b9a1497bb, type: 3}
  m_Name: OrderEnd
  m_EditorClassIdentifier: Game.Runtime::DialogueSO
  entries:
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uD3EC\uC77C\uC5D0 \uC2FC \uC0BC\uAC01\uBC25\uC744 \uCCA0\uD310\uC5D0 \uC62C\uB9B0\uB2E4. \uD45C\uBA74\uC774 \uBC14\uC0AD\uD558\uAC8C \uAD73\uB294\uB2E4."
    choices: []
  - speaker: "\uB808\uB370"
    text: "\uC624, \uC18C\uB9AC \uB09C\uB2E4. \uC774\uAC70 \uC9C4\uC9DC \uBA39\uB294 \uAC70 \uB9DE\uC544?"
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uC2DD\uAE30 \uC804\uC5D0 \uBA39\uC5B4\uC694."
    choices: []
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uB808\uB370\uAC00 \uC0BC\uAC01\uBC25\uC744 \uBC1B\uB294\uB2E4. \uD3EC\uC77C\uC744 \uC7A1\uB294 \uC21C\uAC04 \uCF54\uB97C \uD081\uAC70\uB9B0\uB2E4."
    choices: []
  - speaker: "\uB808\uB370"
    text: "\u2026\uC774 \uB0C4\uC0C8. \uC778\uC1C4\uC18C \uB0C4\uC0C8\uB791 \uBE44\uC2B7\uD574."
    choices: []
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uD55C \uC785 \uBCA0\uC5B4 \uBB38\uB2E4."
    choices: []
  - speaker: "\uB808\uB370"
    text: "\uC57C. \uB9DB\uC788\uB2E4, \uC774\uAC70."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uB2E4\uD589\uC774\uB124\uC694."
    choices:
    - label: "\uB2E4\uD589\uC774\uB124\uC694\n\uAC70\uB798 \uC870\uAC74 \uB9DE\uC8E0?"
      responses:
      - speaker: "\uB808\uB370"
        text: "\uC5B4. \uB0B4\uAC00 \uC190\uD574 \uBCF8 \uAC70 \uC544\uB2CC\uB370? \uD5A5\uC2E0\uB8CC \uB8E8\uD2B8 \uB2E4\uC74C\uC5D0 \uC9C4\uC9DC \uC5F0\uB77D \uC904\uAC8C."
      resultTag: 
    - label: "\uD3EC\uC77C \uB0C4\uC0C8\uC694?\n\uC778\uC1C4\uC18C\uB97C \uC790\uC8FC \uAC14\uC5B4\uC694?"
      responses:
      - speaker: "\uB808\uB370"
        text: "\uBB50\u2014 \uADF8\uB0E5. \uC608\uC804\uC5D0. \uADF8\uB0E5 \uC790\uC8FC \uAC14\uC5B4."
      - speaker: "\uD50C\uB808\uC774\uC5B4"
        text: "\uC65C\uC694?"
      - speaker: "\uB808\uB370"
        text: "\uC57C, \uC0BC\uAC01\uBC25 \uBA39\uC73C\uBA74\uC11C \uADF8\uB7F0 \uAC70 \uBB3C\uC5B4\uBCF4\uBA74 \uB3FC?"
      resultTag: 
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uC0BC\uAC01\uBC25\uC744 \uB2E4 \uBA39\uB294\uB2E4. \uB808\uB370\uB294 \uC790\uB9AC\uC5D0\uC11C \uC77C\uC5B4\uB098\uC9C0 \uC54A\uB294\uB2E4."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uAC70\uB798 \uB05D\uB0AC\uC796\uC544\uC694."
    choices: []
  - speaker: "\uB808\uB370"
    text: "\uC5B4. \u2026\uC544\uC9C1 \uC18C\uD654 \uC911\uC774\uC57C."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uBE60\uB978 \uC0AC\uB78C\uC774 \uC18C\uD654\uAC00 \uB290\uB9AC\uB124\uC694."
    choices: []
  - speaker: "\uB808\uB370"
    text: "\uB098 \uC6D0\uB798 \uADF8\uB798. \uBA39\uACE0 \uB098\uBA74 \uC880 \uC788\uC5B4\uC57C \uD574."
    choices: []
  - speaker: "\uB808\uB370"
    text: "(\uB098\uAC00\uBA70) \uADFC\uB370 \uB9DB\uC788\uC5C8\uC5B4. \uC9C4\uC9DC\uB85C. \uD3EC\uC77C \uB0C4\uC0C8\uAC00 \uC88B\uC558\uC5B4."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uB610 \uC624\uBA74 \uB418\uC796\uC544\uC694."
    choices: []
  - speaker: "\uB808\uB370"
    text: "\uAC70\uB798 \uC788\uC744 \uB54C."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uADF8\uB798\uC694."
    choices: []
  - speaker: "\uB808\uB370"
    text: "\u2026\uBB50, \uAC70\uB798\uC57C \uB9CC\uB4E4\uBA74 \uB418\uC9C0."
    choices: []
