  entries:
  - speaker: "\uB808\uB370"
    text: "\uB2E4\uC2DC \uBD59\uAC8C \uB418\uC5C8\uAD70\uC694. \uC798 \uC9C0\uB0B4\uC168\uC2B5\uB2C8\uAE4C?"
    choices:
    - label: "\uC798 \uC9C0\uB0C5\uB2C8\uB2E4.\\n\uC624\uB298\uB3C4 \uBB34\uC0AC\uD574\uC694."
      responses:
      - speaker: "\uB808\uB370"
        text: "\uADF8\uB807\uAD70\uC694. \uD56D\uC0C1 \uAC74\uAC15\uC774 \uC6B0\uC120\uC785\uB2C8\uB2E4."
      resultTag: 
    - label: "\uC880 \uD53C\uACE4\uD558\uAE34 \uD574\uC694.\\n\uBC30\uB2EC\uC774
        \uB9CE\uC544\uC11C\uC694."
      responses:
      - speaker: "\uB808\uB370"
        text: "\uBAB8 \uC870\uC2EC\uD558\uC2ED\uC2DC\uC624. \uC774 \uAD6C\uC5ED\uC740
          \uC704\uD5D8\uD558\uB2C8\uAE4C\uC694."
      resultTag: 
