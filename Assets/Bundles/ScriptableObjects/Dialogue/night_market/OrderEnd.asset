%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 929a58dbdcff141c4a39130b9a1497bb, type: 3}
  m_Name: OrderEnd
  m_EditorClassIdentifier: Game.Runtime::DialogueSO
  entries:
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uC2A4\uB77C\uB0D0\uAC00 \uAE30\uD0C0 \uCF00\uC774\uC2A4\uB97C \uC5F4\uACE0 \uD29C\uB2DD\uC744 \uC2DC\uC791\uD55C\uB2E4."
    choices: []
  - speaker: "\uC2A4\uB77C\uB0D0"
    text: "\u2026G."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uADF8 \uB2E4\uC74C \uCF54\uB4DC \uCC3E\uC558\uC5B4\uC694?"
    choices:
    - label: "\uADF8 \uB2E4\uC74C \uCF54\uB4DC \uCC3E\uC558\uC5B4\uC694?"
      responses:
      - speaker: "\uC2A4\uB77C\uB0D0"
        text: "\uC9C0\uAE08 \uCC3E\uB294 \uC911\uC774\uC57C. \uB4E4\uC5B4\uBD10."
      resultTag: 
    - label: "(\uC544\uBB34 \uB9D0 \uC5C6\uC774 \uC9C0\uCF1C\uBCF8\uB2E4)"
      responses:
      - speaker: "\uC2A4\uB77C\uB0D0"
        text: "\uC798 \uB4E4\uC5B4. \uD55C \uBC88\uBC16\uC5D0 \uC548 \uCCD0."
      resultTag: 
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uCFF5!! \uC57C\uC2DC\uC7A5 \uC804\uCCB4 \uC815\uC804."
    choices: []
  - speaker: "\uC2A4\uB77C\uB0D0"
    text: "\uAD1C\uCC2E\uC544. \uCF54\uB4DC\uB294 \uBE5B \uC5C6\uC5B4\uB3C4 \uC6B8\uB824."
    choices: []
  - speaker: "\uBAA8\uC544\uC774"
    text: "\uC73C\uD760\u2026 \uC774\uBBF8 \uC0DD\uAC01\uD574\uB480\uC5B4."
    choices: []
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uC624\uD1A0\uBC14\uC774 \uC2DC\uB3D9 \uC18C\uB9AC. \uD5E4\uB4DC\uB77C\uC774\uD2B8 \uB450 \uAC1C\uAC00 \uC2A4\uB77C\uB0D0\uB97C \uC815\uBA74\uC73C\uB85C \uBE44\uCD98\uB2E4."
    choices: []
  - speaker: "\uD30C\uC790\uB9C8"
    text: "\uBD88\uBE5B\uC774 \uC544\uB2C8\uB77C \uAE40\uC774 \uC0AC\uB78C\uB4E4\uC744 \uAC10\uC2F8\uACE0 \uC788\uC5B4\uC694."
    choices: []
  - speaker: "\uBAA8\uC544\uC774"
    text: "\uC73C\uD760\u2026 \uC694\uB9AC\uB3C4 \uBE5B\uC774 \uB418\uB124."
    choices: []
  - speaker: "\uC2A4\uB77C\uB0D0"
    text: "\uC774\uAC74 \uB124 \uB3C4\uC2DC\uB77D \uB355\uBD84\uC5D0 \uBC30\uC6B4 \uB9AC\uB4EC\uC774\uC57C."
    choices: []
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uB2E4\uC74C \uB0A0 \uC544\uCE68. \uD30C\uC790\uB9C8\uAC00 \uD604\uC0C1\uB41C \uD544\uB984 \uD55C \uC7A5\uC744 \uB0B4\uBBFC\uB2E4."
    choices: []
  - speaker: "\uD30C\uC790\uB9C8"
    text: "\uBD88\uBE5B \uC0AC\uC9C4\uC778 \uC904 \uC54C\uC558\uB294\uB370. \uD604\uC0C1\uD558\uACE0 \uBCF4\uB2C8\u2026 \uAE40 \uC0AC\uC9C4\uC774\uC5C8\uC5B4\uC694."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uADF8\uAC8C \uB354 \uB530\uB73B\uD558\uB124\uC694."
    choices:
    - label: "\uADF8\uAC8C \uB354 \uB530\uB73B\uD558\uB124\uC694"
      responses:
      - speaker: "\uD30C\uC790\uB9C8"
        text: "\uB124. \uBE5B\uBCF4\uB2E4 \uC624\uB798 \uB0A8\uC73C\uB2C8\uAE4C."
      resultTag: 
    - label: "\uC798 \uB098\uC654\uC5B4\uC694?"
      responses:
      - speaker: "\uD30C\uC790\uB9C8"
        text: "\uC81C\uAC00 \uCC0D\uC740 \uAC83 \uC911\uC5D0 \uC81C\uC77C \uC88B\uC544\uC694. \uC544\uC9C1\uC740."
      resultTag: 
  - speaker: "\uC2A4\uB77C\uB0D0"
    text: "\u2026G \uB2E4\uC74C\uC774 \uC774\uAC70\uC600\uC5B4."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uB2E4\uC74C\uC5D4 \uCC98\uC74C\uBD80\uD130 \uB4E4\uB824\uC918\uC694."
    choices: []
  - speaker: "\uC2A4\uB77C\uB0D0"
    text: "\u2026\uADF8\uB798."
    choices: []
