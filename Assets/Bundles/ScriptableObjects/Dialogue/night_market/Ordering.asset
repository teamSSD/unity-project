%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 929a58dbdcff141c4a39130b9a1497bb, type: 3}
  m_Name: Ordering
  m_EditorClassIdentifier: Game.Runtime::DialogueSO
  entries:
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uCCA0\uD310 \uC704\uC5D0 \uC5F0\uAE30\uC78E \uBC84\uD130\uAC00 \uC624\uB978\uB2E4. \uD558\uC580 \uC5F0\uAE30 \uD55C \uC904\uAE30\uAC00 \uD53C\uC5B4\uC624\uB978\uB2E4."
    choices: []
  - speaker: "\uD30C\uC790\uB9C8"
    text: "\uC774 \uB0C4\uC0C8\u2026 \uACE0\uCCA0 \uB179\uC774\uB294 \uB0C4\uC0C8\uB791 \uB2EC\uB77C\uC694. \uB354 \uC624\uB798\uB41C \uAC83 \uAC19\uC740."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uD669\uB3D9\uC18C\uAE08 \uB54C\uBB38\uC774\uC5D0\uC694."
    choices:
    - label: "\uD669\uB3D9\uC18C\uAE08 \uB54C\uBB38\uC774\uC5D0\uC694\n\uAD6C\uC2DC\uC7A5 \uBA85\uBB3C\uC774\uC5D0\uC694. \uC1E0 \uB9DB \uAC19\uC9C0\uB9CC \uD600\uC5D0\uC11C \uB179\uC73C\uBA74 \uB2EC\uC544\uC694."
      responses:
      - speaker: "\uD30C\uC790\uB9C8"
        text: "\uAC89\uC774\uB791 \uC18D\uC774 \uB2E4\uB978 \uAC70\uB124\uC694. \uCC0D\uC5B4\uB3C4 \uB420\uAE4C\uC694?"
      - speaker: "\uD50C\uB808\uC774\uC5B4"
        text: "\uB2EC\uC758 \uBFCC\uB9AC \uC62C\uB9AC\uACE0 \uB098\uC11C\uC694."
      resultTag: 
    - label: "\uC9C1\uC811 \uBA39\uC5B4\uBD10\uC694\n\uC124\uBA85\uBCF4\uB2E4 \uBA39\uC5B4\uBCF4\uB294 \uAC8C \uBE68\uB77C\uC694."
      responses:
      - speaker: "\uD30C\uC790\uB9C8"
        text: "\u2026\uBA39\uC73C\uBA74\uC11C \uCC0D\uC744\uAC8C\uC694."
      - speaker: "\uD50C\uB808\uC774\uC5B4"
        text: "\uB2EC\uC758 \uBFCC\uB9AC \uC62C\uB9AC\uACE0 \uB098\uC11C\uC694."
      resultTag: 
  - speaker: "\uB0B4\uB808\uC774\uC158"
    text: "\uB2EC\uC758 \uBFCC\uB9AC\uB97C \uC587\uAC8C \uC36C\uB2E4. \uD558\uC597\uAC8C \uBE5B\uB098\uB294 \uB2E8\uBA74\uC774 \uBD88\uBE5B \uC544\uB798 \uBC18\uC9DD\uC778\uB2E4."
    choices: []
  - speaker: "\uBAA8\uC544\uC774"
    text: "\uC800\uAC8C \uB2EC\uC758 \uBFCC\uB9AC? \uC9C4\uC9DC \uB2EC \uC870\uAC01 \uAC19\uC740\uB370."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uBA39\uC5B4\uBCF4\uBA74 \uC54C\uC544\uC694."
    choices: []
  - speaker: "\uBAA8\uC544\uC774"
    text: "\uC73C\uD760\u2026 \uAE30\uB300\uB41C\uB2E4."
    choices: []
  - speaker: "\uC2A4\uB77C\uB0D0"
    text: "\u2026\uC654\uC5B4."
    choices: []
  - speaker: "\uC2A4\uB77C\uB0D0"
    text: "\uD669\uB3D9\uC18C\uAE08. \uCC98\uC74C\uC5D4 \uC1E0 \uB9DB\uC778\uB370, \uB05D\uC5D0\uC11C \uB2EC\uC544."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uB9DE\uC544\uC694."
    choices: []
  - speaker: "\uC2A4\uB77C\uB0D0"
    text: "\uADF8\uAC70 \uC54C\uC544? \uB0B4\uAC00 \uBC34\uB4DC \uB54C \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uCCE4\uB358 \uCF54\uB4DC\uAC00\u2026 G\uC600\uC5B4. \uAC70\uAE30\uC11C \uB04A\uACBC\uAC70\uB4E0. \uADFC\uB370 \uC624\uB298, \uC774\uAC70 \uBA39\uC73C\uBA74\uC11C \uADF8 \uB2E4\uC74C \uCF54\uB4DC\uAC00 \uC0DD\uAC01\uB0AC\uC5B4."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uCC3E\uC73C\uBA74 \uC54C\uB824\uC918\uC694."
    choices:
    - label: "\uCC3E\uC73C\uBA74 \uC54C\uB824\uC918\uC694"
      responses:
      - speaker: "\uC2A4\uB77C\uB0D0"
        text: "\u2026\uADF8\uB798. \uC624\uB298 \uC548\uC5D0 \uCC3E\uC744 \uC218\uB3C4 \uC788\uC5B4."
      resultTag: 
    - label: "\uBB54\uB370\uC694?"
      responses:
      - speaker: "\uC2A4\uB77C\uB0D0"
        text: "\uC544\uC9C1 \uBAB0\uB77C. \uADFC\uB370 \uC774\uC81C \uCC3E\uC744 \uC218 \uC788\uC744 \uAC83 \uAC19\uC544."
      resultTag: 
