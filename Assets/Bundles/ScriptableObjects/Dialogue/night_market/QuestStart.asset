%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 929a58dbdcff141c4a39130b9a1497bb, type: 3}
  m_Name: QuestStart
  m_EditorClassIdentifier: Game.Runtime::DialogueSO
  entries:
  - speaker: "\uD30C\uC790\uB9C8"
    text: "\uC624\uB298 \uD558\uB298\uC740\u2026 \uC5F0\uAE30\uC78E \uBC84\uD130 \uC0C9\uC774\uB124\uC694."
    choices: []
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\uADF8\uAC8C \uBB34\uC2A8 \uC0C9\uC774\uC5D0\uC694?"
    choices: []
  - speaker: "\uD30C\uC790\uB9C8"
    text: "\uBD88 \uBD99\uC774\uAE30 \uC9C1\uC804\uC5D0 \uC7A0\uAE50 \uC788\uB294 \uC0C9\uC774\uC694. \uD0C0\uC9C0\uB3C4 \uC54A\uACE0, \uAEBC\uC9C0\uC9C0\uB3C4 \uC54A\uC740."
    choices: []
  - speaker: "\uBAA8\uC544\uC774"
    text: "\uC7AC\uB8CC \uBC30\uB2EC \uC644\uB8CC. \uCCAD\uC720, \uD669\uB3D9\uC18C\uAE08, \uB2EC\uC758 \uBFCC\uB9AC\u2026 \uC804\uBD80 \uC788\uC5B4. \uC73C\uD760."
    choices: []
  - speaker: "\uD30C\uC790\uB9C8"
    text: "\uBD80\uC2A4, \uC624\uB298 \uC5F4 \uAC70\uC8E0?"
    choices:
    - label: "\uC5F4\uC5B4\uC694\n\uC57C\uC2DC\uC7A5\uC774\uC796\uC544\uC694. \uB2F9\uC5F0\uD788 \uC5F4\uC5B4\uC57C\uC8E0."
      responses:
      - speaker: "\uD30C\uC790\uB9C8"
        text: "\uADF8\uB7FC \uC800\uB294 \uC606\uC5D0\uC11C \uCC0D\uC744\uAC8C\uC694. \uB3C4\uC2DC\uB77D\uB3C4 \uAC19\uC774\uC694."
      - speaker: "\uBAA8\uC544\uC774"
        text: "\uC73C\uD760\u2026 \uC9C4\uB3D9 \uB290\uAEF4\uC9C4\uB2E4. \uC0AC\uB78C\uB4E4\uC774 \uBC8C\uC368 \uBAA8\uC774\uACE0 \uC788\uC5B4."
      - speaker: "\uD50C\uB808\uC774\uC5B4"
        text: "\uADF8\uB7FC \uC2DC\uC791\uD574\uC694."
      resultTag: accept
    - label: "\uC798 \uD314\uB9B4\uC9C0 \uBAA8\uB974\uACA0\uC5B4\uC694\n\uC57C\uC2DC\uC7A5 \uC190\uB2D8\uB4E4\uC774 \uBA39\uC5B4\uC904\uC9C0 \uBAB0\uB77C\uC11C\uC694."
      responses:
      - speaker: "\uD30C\uC790\uB9C8"
        text: "\uB0C4\uC0C8\uAC00 \uC0AC\uB78C\uC744 \uB04C\uC5B4\uC624\uC796\uC544\uC694. \uB0C4\uC0C8 \uBA3C\uC800 \uB9CC\uB4E4\uBA74 \uB3FC\uC694."
      - speaker: "\uBAA8\uC544\uC774"
        text: "\uB3CC\uB3C4 \uCC98\uC74C\uC5D4 \uADF8\uB0E5 \uB3CC\uC774\uC57C. \uC73C\uD760."
      - speaker: "\uD30C\uC790\uB9C8"
        text: "\uC900\uBE44\uB418\uBA74 \uBD88 \uCF1C\uC694."
      resultTag: accept
